{
  "name": "apex-content-interviewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "test:authorship": "node --test scripts/article-authorship.test.mjs",
    "test:dispatcher": "node --test scripts/campaign-dispatcher.test.mjs",
    "test:verified-practices": "node --test scripts/verified-practice-workflows.test.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
