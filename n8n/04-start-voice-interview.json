        "authentication": "serviceAccount",
        "projectId": {
          "__rl": true,
          "value": "apex-marketing-n8n",
          "mode": "id"
        },
        "sqlQuery": "SELECT\n  IF(il.link_id IS NOT NULL, 'true', 'false') AS valid,\n  IF(il.link_id IS NOT NULL, 'VALID', 'INVALID_OR_EXPIRED') AS validation_status,\n  il.link_id,\n  il.campaign_id,\n  il.doctor_id,\n  il.topic_id\nFROM (SELECT 1 AS seed) s\nLEFT JOIN (\n  SELECT\n    link_id,\n    campaign_id,\n    doctor_id,\n    topic_id\n  FROM\n    `apex-marketing-n8n.automated_article_creation.interview_links`\n  WHERE\n    secure_token_hash = TO_HEX(SHA256(@token))\n    AND expires_at > CURRENT_TIMESTAMP()\n    AND status IN ('READY', 'OPENED')\n    AND used_at IS NULL\n  QUALIFY\n    ROW_NUMBER() OVER (ORDER BY created_at DESC) = 1\n) il\nON TRUE;",
        "options": {
          "location": "US",
          "queryParameters": {
            "namedParameters": [
              {
                "name": "token",
                "value": "={{ $json.body.token }}"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
        -420,
